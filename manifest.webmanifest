      "short_name": "Calendar",
      "url": "./#calendar",
      "icons": [
        {
          "src": "assets/icons/shortcut-calendar-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "url": "./#settings",
      "icons": [
        {
          "src": "assets/icons/shortcut-settings-96.png",
