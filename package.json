{
  "name": "mylife-dashboard",
  "version": "2.0.2",
  "private": true,
  "description": "MYLIFE private life dashboard packaged for web, PWA, Android, and iOS.",
  "scripts": {
    "build": "node tools/build-static.js",
    "start": "node tools/local-server.js",
    "serve": "node tools/local-server.js",
    "verify:sync": "node tools/verify-sync.js",
    "bump": "node tools/bump-versions.js",
    "mobile:sync": "node tools/copy-web.js && npx cap sync",
    "mobile:add:android": "node tools/copy-web.js && npx cap add android",
    "mobile:add:ios": "node tools/copy-web.js && npx cap add ios",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.55.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@upstash/redis": "^1.39.0",
    "harfbuzzjs": "^0.4.7",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^6.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3"
  }
}
