{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/dispatch",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/dispatch.js": {
      "includeFiles": "{lib/fonts/**,node_modules/harfbuzzjs/hb.wasm,node_modules/harfbuzzjs/hb.js}"
    },
    "api/telegram-webhook.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{lib/fonts/**,node_modules/harfbuzzjs/hb.wasm,node_modules/harfbuzzjs/hb.js,node_modules/tesseract.js/**,node_modules/tesseract.js-core/**,node_modules/@tesseract.js-data/eng/4.0.0_best_int/**,node_modules/bmp-js/**,node_modules/is-url/**,node_modules/node-fetch/**,node_modules/whatwg-url/**,node_modules/webidl-conversions/**,node_modules/tr46/**,node_modules/regenerator-runtime/**,node_modules/wasm-feature-detect/**,node_modules/zlibjs/**,node_modules/idb-keyval/**,node_modules/pdfjs-dist/legacy/build/**,js/scan-parse.js,js/bill-pay.js,js/notify-prefs.js,js/smart-parse.js}"
    }
  }
}
