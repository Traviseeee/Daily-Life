{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/dispatch",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/dispatch.js": {
      "includeFiles": "{lib/fonts/**,node_modules/harfbuzzjs/hb.wasm,node_modules/harfbuzzjs/hb.js}"
    }
  }
}
