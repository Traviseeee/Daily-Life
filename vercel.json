{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/dispatch",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/dispatch.js": {
      "includeFiles": "{lib/fonts/**,node_modules/harfbuzzjs/hb.wasm,node_modules/harfbuzzjs/hb.js}"
    },
    "api/telegram-webhook.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{lib/**,js/*.js,node_modules/{harfbuzzjs,tesseract.js,tesseract.js-core,@tesseract.js-data,bmp-js,is-url,node-fetch,whatwg-url,webidl-conversions,tr46,regenerator-runtime,wasm-feature-detect,zlibjs,idb-keyval}/**,node_modules/pdfjs-dist/legacy/**}"
    }
  }
}
